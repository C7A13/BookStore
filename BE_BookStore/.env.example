# --- SERVER CONFIG & SECURITY ---
# Expiration times are in seconds or milliseconds depending on your framework setup
ACCESS_TOKEN_EXPIRATION=900
REFRESH_TOKEN_EXPIRATION=604800
API_SIGNER_KEY=your_api_signer_key_here
API_VERIFY_SIGNER_KEY=your_api_verify_signer_key_here

# --- DATABASE / CACHE CONFIG ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# --- CLOUDINARY CONFIG ---
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name_here
CLOUDINARY_API_KEY=your_cloudinary_api_key_here 
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_here

# --- BREVO EMAIL SERVICE CONFIG ---
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=your_sender_email_here@domain.com

# --- OAUTH2 AUTHENTICATION (GOOGLE & FACEBOOK) ---
FB_CLIENT_ID=your_fb_client_id_here
FB_CLIENT_SECRET=your_fb_client_secret_here

GG_CLIENT_ID=your_gg_client_id_here
GG_CLIENT_SECRET=your_gg_client_secret_here

# --- VNPAY PAYMENT GATEWAY CONFIG ---
VNPAY_TMN_CODE=your_vnpay_tmn_code_here
VNPAY_HASH_SECRET=your_vnpay_hash_secret_here
VNPAY_IPN_URL=http://localhost:8080/payments/vnpay/ipn
VNPAY_RETURN_URL=http://localhost:8080/payments/vnpay/return